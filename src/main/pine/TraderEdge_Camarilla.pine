// =============================================================================
// TraderEdge Camarilla
// -----------------------------------------------------------------------------
// Visualises the Camarilla pivot levels + two-candle confirmation/trigger
// signals used by the Spring Boot trading bot (rydytrader/autotradercpr,
// camarilla-options-selling-v2 branch). Levels are computed from prior
// trading day's OHLC (weekends + NSE holidays are skipped automatically by
// the Pine `request.security` daily calendar).
//
// NOTE — H5 formula divergence: this script uses the bot's variant
//   H5 = (H/L) × C    L5 = C − (H5 − C)
// which is NOT the canonical 1.1×range×4 form. Sticking with the bot's
// variant guarantees signal parity with the bot's `Camarilla.java` logic.
//
// Signal state machine matches Camarilla.java#L783-L836 — four phases on
// every 5-minute close: trigger → expire → invalidate → detect-new. Signals
// only render when the chart timeframe is 5 minutes (otherwise the 6-bar
// pending window would not equal 30 minutes and would not match the bot).
// =============================================================================

//@version=5
indicator("TraderEdge Camarilla",
     shorttitle="TE Camarilla",
     overlay=true,
     max_lines_count=500,
     max_labels_count=500,
     max_bars_back=5000)

// ── Inputs ──────────────────────────────────────────────────────────────────
// Daily pivots
gDaily        = "Daily Pivots"
showDaily     = input.bool(true,  "Show daily pivots",          group=gDaily)
pastDays      = input.int(5,      "Past pivots (incl. today)",  minval=1, maxval=30, group=gDaily)
showNextDay   = input.bool(true,  "Show next-day projection",   group=gDaily)
showPP        = input.bool(false, "Show PP (pivot point)",      group=gDaily)
showLabels    = input.bool(true,  "Show level labels",          group=gDaily)
dailyStyleStr = input.string("solid", "Line style", options=["solid","dashed","dotted"], group=gDaily)

gDailyCol = "Daily Pivot Colours"
h3Col = input.color(color.red,        "H3", group=gDailyCol, inline="h3")
h3W   = input.int(2, "",              minval=1, maxval=5, group=gDailyCol, inline="h3")
h4Col = input.color(color.green,      "H4", group=gDailyCol, inline="h4")
h4W   = input.int(2, "",              minval=1, maxval=5, group=gDailyCol, inline="h4")
h5Col = input.color(color.purple,     "H5", group=gDailyCol, inline="h5")
h5W   = input.int(1, "",              minval=1, maxval=5, group=gDailyCol, inline="h5")
l3Col = input.color(color.green,      "L3", group=gDailyCol, inline="l3")
l3W   = input.int(2, "",              minval=1, maxval=5, group=gDailyCol, inline="l3")
l4Col = input.color(color.red,        "L4", group=gDailyCol, inline="l4")
l4W   = input.int(2, "",              minval=1, maxval=5, group=gDailyCol, inline="l4")
l5Col = input.color(color.purple,     "L5", group=gDailyCol, inline="l5")
l5W   = input.int(1, "",              minval=1, maxval=5, group=gDailyCol, inline="l5")
ppCol = input.color(color.gray,       "PP", group=gDailyCol, inline="pp")
ppW   = input.int(1, "",              minval=1, maxval=5, group=gDailyCol, inline="pp")

// Weekly pivots
gWeekly        = "Weekly Pivots"
showWeekly     = input.bool(false, "Show weekly pivots",  group=gWeekly)
weeklyStyleStr = input.string("dashed", "Line style", options=["solid","dashed","dotted"], group=gWeekly)
showWeeklyLbl  = input.bool(true,  "Show level labels",   group=gWeekly)

gWeeklyCol = "Weekly Pivot Colours"
wh3Col = input.color(color.new(color.red,    30), "H3", group=gWeeklyCol, inline="wh3")
wh3W   = input.int(1, "",                          minval=1, maxval=5, group=gWeeklyCol, inline="wh3")
wh4Col = input.color(color.new(color.green,  30), "H4", group=gWeeklyCol, inline="wh4")
wh4W   = input.int(1, "",                          minval=1, maxval=5, group=gWeeklyCol, inline="wh4")
wh5Col = input.color(color.new(color.purple, 30), "H5", group=gWeeklyCol, inline="wh5")
wh5W   = input.int(1, "",                          minval=1, maxval=5, group=gWeeklyCol, inline="wh5")
wl3Col = input.color(color.new(color.green,  30), "L3", group=gWeeklyCol, inline="wl3")
wl3W   = input.int(1, "",                          minval=1, maxval=5, group=gWeeklyCol, inline="wl3")
wl4Col = input.color(color.new(color.red,    30), "L4", group=gWeeklyCol, inline="wl4")
wl4W   = input.int(1, "",                          minval=1, maxval=5, group=gWeeklyCol, inline="wl4")
wl5Col = input.color(color.new(color.purple, 30), "L5", group=gWeeklyCol, inline="wl5")
wl5W   = input.int(1, "",                          minval=1, maxval=5, group=gWeeklyCol, inline="wl5")

// Signals
gSig         = "Signals"
showSignals  = input.bool(true,   "Show buy/sell signals",  group=gSig)
maxPending   = input.int(6,       "Max pending bars",       minval=1, maxval=20, group=gSig)
buyColor     = input.color(color.green, "BUY arrow colour", group=gSig)
sellColor    = input.color(color.red,   "SELL arrow colour", group=gSig)
showSetupLbl = input.bool(true,   "Show setup label",       group=gSig)
arrowSizeStr = input.string("normal", "Arrow size", options=["tiny","small","normal","large","huge"], group=gSig)

// ── Resolve dropdown strings to Pine constants ──────────────────────────────
dailyLineStyle  = dailyStyleStr  == "solid" ? line.style_solid : dailyStyleStr  == "dashed" ? line.style_dashed : line.style_dotted
weeklyLineStyle = weeklyStyleStr == "solid" ? line.style_solid : weeklyStyleStr == "dashed" ? line.style_dashed : line.style_dotted
// `plotshape` requires `size` to be a compile-time const string, so we
// can't pass a runtime-resolved ternary into it. The fix below: one
// `plotshape` per size option, gated on the input matching that option —
// only the matching pair actually renders.
isTiny   = arrowSizeStr == "tiny"
isSmall  = arrowSizeStr == "small"
isNormal = arrowSizeStr == "normal"
isLarge  = arrowSizeStr == "large"
isHuge   = arrowSizeStr == "huge"

// ── Camarilla formula — verbatim from CamarillaLevels.compute ───────────────
// (`range` is a Pine v5 reserved keyword, so the local uses `rng`.)
camarilla(float h, float l, float c) =>
    float rng = h - l
    float k   = rng * 1.1
    float h3  = c + k / 4.0
    float h4  = c + k / 2.0
    float h5  = l > 0 ? (h / l) * c : c
    float l3  = c - k / 4.0
    float l4  = c - k / 2.0
    float l5  = c - (h5 - c)
    float pp  = (h + l + c) / 3.0
    [h3, h4, h5, l3, l4, l5, pp]

// ── Prior-day + prior-week OHLC ─────────────────────────────────────────────
// `lookahead_on` + `[1]` is the canonical Pine idiom for "give me the LAST
// COMPLETED higher-timeframe bar, on every intraday bar, without leak".
priorDayHigh  = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
priorDayLow   = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
priorDayClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

priorWeekHigh  = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_on)
priorWeekLow   = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_on)
priorWeekClose = request.security(syminfo.tickerid, "W", close[1], lookahead=barmerge.lookahead_on)

// ── Boundary detection ──────────────────────────────────────────────────────
isNewDay  = ta.change(time("D")) != 0
isNewWeek = ta.change(time("W")) != 0

// ── Persistent line + label arrays for past pivots ──────────────────────────
// One array per level so we can age out the oldest day's set when the
// operator's "pastDays" cap is exceeded.
var array<line>  histH3  = array.new<line>()
var array<line>  histH4  = array.new<line>()
var array<line>  histH5  = array.new<line>()
var array<line>  histL3  = array.new<line>()
var array<line>  histL4  = array.new<line>()
var array<line>  histL5  = array.new<line>()
var array<line>  histPP  = array.new<line>()
var array<label> histLbl = array.new<label>()

// Weekly persistent line arrays
var array<line>  wHistH3 = array.new<line>()
var array<line>  wHistH4 = array.new<line>()
var array<line>  wHistH5 = array.new<line>()
var array<line>  wHistL3 = array.new<line>()
var array<line>  wHistL4 = array.new<line>()
var array<line>  wHistL5 = array.new<line>()
var array<label> wHistLbl = array.new<label>()

// Trim helper: drop the oldest entry from an array<line> and delete the line.
trimLines(array<line> arr, int cap) =>
    while array.size(arr) > cap
        line old = array.shift(arr)
        line.delete(old)

trimLabels(array<label> arr, int cap) =>
    while array.size(arr) > cap
        label old = array.shift(arr)
        label.delete(old)

// Cap the previous element's x2 to the supplied time so the just-finalised
// day's lines terminate cleanly at the new day's open, instead of extending
// into the next day.
finalizePrevX2(array<line> arr, int t) =>
    int n = array.size(arr)
    if n > 0
        line prev = array.get(arr, n - 1)
        line.set_x2(prev, t)

// ── Daily pivot drawing ─────────────────────────────────────────────────────
// On every new daily bar boundary, finalise the previous day's lines (clip
// their x2 to today's open) and draw a fresh six-line set for today.
// Today's lines extend ~24 hours forward; they get clipped tomorrow when
// the next isNewDay fires.
if showDaily and isNewDay and not na(priorDayHigh) and not na(priorDayLow) and not na(priorDayClose)
    [h3, h4, h5, l3, l4, l5, pp] = camarilla(priorDayHigh, priorDayLow, priorDayClose)
    int x1 = time
    int x2 = time + 24 * 60 * 60 * 1000

    // Finalise the previous day's lines so they don't bleed into today.
    finalizePrevX2(histH3, x1)
    finalizePrevX2(histH4, x1)
    finalizePrevX2(histH5, x1)
    finalizePrevX2(histL3, x1)
    finalizePrevX2(histL4, x1)
    finalizePrevX2(histL5, x1)
    if showPP
        finalizePrevX2(histPP, x1)

    array.push(histH3, line.new(x1, h3, x2, h3, xloc=xloc.bar_time, color=h3Col, width=h3W, style=dailyLineStyle))
    array.push(histH4, line.new(x1, h4, x2, h4, xloc=xloc.bar_time, color=h4Col, width=h4W, style=dailyLineStyle))
    array.push(histH5, line.new(x1, h5, x2, h5, xloc=xloc.bar_time, color=h5Col, width=h5W, style=dailyLineStyle))
    array.push(histL3, line.new(x1, l3, x2, l3, xloc=xloc.bar_time, color=l3Col, width=l3W, style=dailyLineStyle))
    array.push(histL4, line.new(x1, l4, x2, l4, xloc=xloc.bar_time, color=l4Col, width=l4W, style=dailyLineStyle))
    array.push(histL5, line.new(x1, l5, x2, l5, xloc=xloc.bar_time, color=l5Col, width=l5W, style=dailyLineStyle))
    if showPP
        array.push(histPP, line.new(x1, pp, x2, pp, xloc=xloc.bar_time, color=ppCol, width=ppW, style=dailyLineStyle))

    if showLabels
        array.push(histLbl, label.new(x2, h3, "H3", xloc=xloc.bar_time, textcolor=h3Col, style=label.style_label_left, color=color.new(h3Col, 90), size=size.tiny))
        array.push(histLbl, label.new(x2, h4, "H4", xloc=xloc.bar_time, textcolor=h4Col, style=label.style_label_left, color=color.new(h4Col, 90), size=size.tiny))
        array.push(histLbl, label.new(x2, h5, "H5", xloc=xloc.bar_time, textcolor=h5Col, style=label.style_label_left, color=color.new(h5Col, 90), size=size.tiny))
        array.push(histLbl, label.new(x2, l3, "L3", xloc=xloc.bar_time, textcolor=l3Col, style=label.style_label_left, color=color.new(l3Col, 90), size=size.tiny))
        array.push(histLbl, label.new(x2, l4, "L4", xloc=xloc.bar_time, textcolor=l4Col, style=label.style_label_left, color=color.new(l4Col, 90), size=size.tiny))
        array.push(histLbl, label.new(x2, l5, "L5", xloc=xloc.bar_time, textcolor=l5Col, style=label.style_label_left, color=color.new(l5Col, 90), size=size.tiny))
        if showPP
            array.push(histLbl, label.new(x2, pp, "PP", xloc=xloc.bar_time, textcolor=ppCol, style=label.style_label_left, color=color.new(ppCol, 90), size=size.tiny))

    // Cap history at the operator's pastDays setting. Labels are 6× or 7×
    // per day, so multiply cap accordingly.
    trimLines(histH3, pastDays)
    trimLines(histH4, pastDays)
    trimLines(histH5, pastDays)
    trimLines(histL3, pastDays)
    trimLines(histL4, pastDays)
    trimLines(histL5, pastDays)
    trimLines(histPP, pastDays)
    int lblPerDay = showPP ? 7 : 6
    trimLabels(histLbl, pastDays * lblPerDay)

// ── Weekly pivot drawing ────────────────────────────────────────────────────
if showWeekly and isNewWeek and not na(priorWeekHigh) and not na(priorWeekLow) and not na(priorWeekClose)
    [wh3, wh4, wh5, wl3, wl4, wl5, _wpp] = camarilla(priorWeekHigh, priorWeekLow, priorWeekClose)
    int wx1 = time
    int wx2 = time + 7 * 24 * 60 * 60 * 1000

    finalizePrevX2(wHistH3, wx1)
    finalizePrevX2(wHistH4, wx1)
    finalizePrevX2(wHistH5, wx1)
    finalizePrevX2(wHistL3, wx1)
    finalizePrevX2(wHistL4, wx1)
    finalizePrevX2(wHistL5, wx1)

    array.push(wHistH3, line.new(wx1, wh3, wx2, wh3, xloc=xloc.bar_time, color=wh3Col, width=wh3W, style=weeklyLineStyle))
    array.push(wHistH4, line.new(wx1, wh4, wx2, wh4, xloc=xloc.bar_time, color=wh4Col, width=wh4W, style=weeklyLineStyle))
    array.push(wHistH5, line.new(wx1, wh5, wx2, wh5, xloc=xloc.bar_time, color=wh5Col, width=wh5W, style=weeklyLineStyle))
    array.push(wHistL3, line.new(wx1, wl3, wx2, wl3, xloc=xloc.bar_time, color=wl3Col, width=wl3W, style=weeklyLineStyle))
    array.push(wHistL4, line.new(wx1, wl4, wx2, wl4, xloc=xloc.bar_time, color=wl4Col, width=wl4W, style=weeklyLineStyle))
    array.push(wHistL5, line.new(wx1, wl5, wx2, wl5, xloc=xloc.bar_time, color=wl5Col, width=wl5W, style=weeklyLineStyle))

    if showWeeklyLbl
        array.push(wHistLbl, label.new(wx2, wh3, "wH3", xloc=xloc.bar_time, textcolor=wh3Col, style=label.style_label_left, color=color.new(wh3Col, 90), size=size.tiny))
        array.push(wHistLbl, label.new(wx2, wh4, "wH4", xloc=xloc.bar_time, textcolor=wh4Col, style=label.style_label_left, color=color.new(wh4Col, 90), size=size.tiny))
        array.push(wHistLbl, label.new(wx2, wh5, "wH5", xloc=xloc.bar_time, textcolor=wh5Col, style=label.style_label_left, color=color.new(wh5Col, 90), size=size.tiny))
        array.push(wHistLbl, label.new(wx2, wl3, "wL3", xloc=xloc.bar_time, textcolor=wl3Col, style=label.style_label_left, color=color.new(wl3Col, 90), size=size.tiny))
        array.push(wHistLbl, label.new(wx2, wl4, "wL4", xloc=xloc.bar_time, textcolor=wl4Col, style=label.style_label_left, color=color.new(wl4Col, 90), size=size.tiny))
        array.push(wHistLbl, label.new(wx2, wl5, "wL5", xloc=xloc.bar_time, textcolor=wl5Col, style=label.style_label_left, color=color.new(wl5Col, 90), size=size.tiny))

    // Weekly history capped at 12 weeks to stay safely under the 500-line
    // cap even when daily history is at its 30-day max.
    int weeklyCap = 12
    trimLines(wHistH3, weeklyCap)
    trimLines(wHistH4, weeklyCap)
    trimLines(wHistH5, weeklyCap)
    trimLines(wHistL3, weeklyCap)
    trimLines(wHistL4, weeklyCap)
    trimLines(wHistL5, weeklyCap)
    trimLabels(wHistLbl, weeklyCap * 6)

// ── Next-day projection ────────────────────────────────────────────────────
// Compute the candidate pivot levels for tomorrow using today's running
// OHLC (high/low/close-so-far). Lines are redrawn on every bar in the
// session so the projection evolves with the day's price action; when the
// next isNewDay fires, the projection becomes today's actual lines via the
// regular `if isNewDay` block above.
var float dayHi  = na
var float dayLo  = na
var line projH3  = na
var line projH4  = na
var line projH5  = na
var line projL3  = na
var line projL4  = na
var line projL5  = na
var label projHi3 = na
var label projHi4 = na
var label projHi5 = na
var label projLo3 = na
var label projLo4 = na
var label projLo5 = na

if isNewDay
    dayHi := high
    dayLo := low
else
    dayHi := na(dayHi) ? high : math.max(dayHi, high)
    dayLo := na(dayLo) ? low  : math.min(dayLo, low)

if showDaily and showNextDay and barstate.isconfirmed and not na(dayHi) and not na(dayLo)
    // Delete the previous projection so the new draw is the only set in
    // play. Pine ignores delete() on `na` line ids.
    line.delete(projH3)
    line.delete(projH4)
    line.delete(projH5)
    line.delete(projL3)
    line.delete(projL4)
    line.delete(projL5)
    label.delete(projHi3)
    label.delete(projHi4)
    label.delete(projHi5)
    label.delete(projLo3)
    label.delete(projLo4)
    label.delete(projLo5)

    [ph3, ph4, ph5, pl3, pl4, pl5, _ppp] = camarilla(dayHi, dayLo, close)
    int px1 = time + 24 * 60 * 60 * 1000
    int px2 = px1   + 24 * 60 * 60 * 1000
    projH3 := line.new(px1, ph3, px2, ph3, xloc=xloc.bar_time, color=color.new(h3Col, 50), width=h3W, style=line.style_dotted)
    projH4 := line.new(px1, ph4, px2, ph4, xloc=xloc.bar_time, color=color.new(h4Col, 50), width=h4W, style=line.style_dotted)
    projH5 := line.new(px1, ph5, px2, ph5, xloc=xloc.bar_time, color=color.new(h5Col, 50), width=h5W, style=line.style_dotted)
    projL3 := line.new(px1, pl3, px2, pl3, xloc=xloc.bar_time, color=color.new(l3Col, 50), width=l3W, style=line.style_dotted)
    projL4 := line.new(px1, pl4, px2, pl4, xloc=xloc.bar_time, color=color.new(l4Col, 50), width=l4W, style=line.style_dotted)
    projL5 := line.new(px1, pl5, px2, pl5, xloc=xloc.bar_time, color=color.new(l5Col, 50), width=l5W, style=line.style_dotted)
    if showLabels
        projHi3 := label.new(px2, ph3, "H3'", xloc=xloc.bar_time, textcolor=h3Col, style=label.style_label_left, color=color.new(h3Col, 95), size=size.tiny)
        projHi4 := label.new(px2, ph4, "H4'", xloc=xloc.bar_time, textcolor=h4Col, style=label.style_label_left, color=color.new(h4Col, 95), size=size.tiny)
        projHi5 := label.new(px2, ph5, "H5'", xloc=xloc.bar_time, textcolor=h5Col, style=label.style_label_left, color=color.new(h5Col, 95), size=size.tiny)
        projLo3 := label.new(px2, pl3, "L3'", xloc=xloc.bar_time, textcolor=l3Col, style=label.style_label_left, color=color.new(l3Col, 95), size=size.tiny)
        projLo4 := label.new(px2, pl4, "L4'", xloc=xloc.bar_time, textcolor=l4Col, style=label.style_label_left, color=color.new(l4Col, 95), size=size.tiny)
        projLo5 := label.new(px2, pl5, "L5'", xloc=xloc.bar_time, textcolor=l5Col, style=label.style_label_left, color=color.new(l5Col, 95), size=size.tiny)

// ── 5-minute timeframe warning ──────────────────────────────────────────────
var label tfWarn = na
isFiveMin = timeframe.period == "5"
if showSignals and not isFiveMin and barstate.islast
    label.delete(tfWarn)
    tfWarn := label.new(bar_index, high, "TraderEdge Camarilla — signals require 5m timeframe",
         style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white,
         size=size.normal)
else if isFiveMin
    label.delete(tfWarn)
    tfWarn := na

// ── Signal state machine — mirror of Camarilla.java four-phase walk ─────────
// Bullish (pb) and bearish (pr) slots persist across bars via var. Phase
// order: trigger → expire → invalidate → detect-new, identical to the bot.
// Setup IDs: 1=L3R, 2=H4B (bullish); 3=H3R, 4=L4B (bearish).
var float pbConfHigh   = na
var float pbConfLow    = na
var float pbTargetLvl  = na
var int   pbBarIdx     = na
var int   pbSetupId    = na

var float prConfHigh   = na
var float prConfLow    = na
var float prTargetLvl  = na
var int   prBarIdx     = na
var int   prSetupId    = na

buySignal  = false
sellSignal = false
string buyLabel  = ""
string sellLabel = ""

// Run signal logic ONLY on confirmed (closed) 5-min bars. `isconfirmed`
// matches the bot's "on candle close" semantic — never fires mid-bar.
if showSignals and isFiveMin and barstate.isconfirmed
    bool isGreen = close > open
    bool isRed   = close < open

    // Resolve today's Camarilla levels for use in Phase 4.
    [sh3, sh4, sh5, sl3, sl4, sl5, _spp] = camarilla(priorDayHigh, priorDayLow, priorDayClose)

    // ── Phase 1: TRIGGER ──
    if not na(pbConfHigh) and isGreen and close > pbConfHigh
        buySignal := true
        buyLabel  := pbSetupId == 1 ? "L3R" : "H4B"
        pbConfHigh   := na
        pbConfLow    := na
        pbTargetLvl  := na
        pbBarIdx     := na
        pbSetupId    := na

    if not na(prConfLow) and isRed and close < prConfLow
        sellSignal := true
        sellLabel  := prSetupId == 3 ? "H3R" : "L4B"
        prConfHigh   := na
        prConfLow    := na
        prTargetLvl  := na
        prBarIdx     := na
        prSetupId    := na

    // ── Phase 2: EXPIRY (>= maxPending bars elapsed) ──
    if not na(pbBarIdx) and (bar_index - pbBarIdx) >= maxPending
        pbConfHigh   := na
        pbConfLow    := na
        pbTargetLvl  := na
        pbBarIdx     := na
        pbSetupId    := na
    if not na(prBarIdx) and (bar_index - prBarIdx) >= maxPending
        prConfHigh   := na
        prConfLow    := na
        prTargetLvl  := na
        prBarIdx     := na
        prSetupId    := na

    // ── Phase 3: INVALIDATION ──
    if not na(pbConfLow) and close < pbConfLow
        pbConfHigh   := na
        pbConfLow    := na
        pbTargetLvl  := na
        pbBarIdx     := na
        pbSetupId    := na
    if not na(prConfHigh) and close > prConfHigh
        prConfHigh   := na
        prConfLow    := na
        prTargetLvl  := na
        prBarIdx     := na
        prSetupId    := na

    // ── Phase 4: NEW CONFIRMATION (only if BOTH slots empty) ──
    if na(pbConfHigh) and na(prConfHigh) and not na(sh3) and not na(sl3)
        if isGreen and low <= sl3 and close > sl3
            pbConfHigh   := high
            pbConfLow    := low
            pbTargetLvl  := sh3
            pbBarIdx     := bar_index
            pbSetupId    := 1
        else if isGreen and low <= sh4 and close > sh4
            pbConfHigh   := high
            pbConfLow    := low
            pbTargetLvl  := sh5
            pbBarIdx     := bar_index
            pbSetupId    := 2
        else if isRed and high >= sh3 and close < sh3
            prConfHigh   := high
            prConfLow    := low
            prTargetLvl  := sl3
            prBarIdx     := bar_index
            prSetupId    := 3
        else if isRed and high >= sl4 and close < sl4
            prConfHigh   := high
            prConfLow    := low
            prTargetLvl  := sl5
            prBarIdx     := bar_index
            prSetupId    := 4

// ── Arrow + setup-label rendering ──────────────────────────────────────────
// One plotshape per size option, gated so only the matching one fires.
// Titles are unique per pair so TradingView's plot list stays readable.
plotshape(buySignal and isTiny,   title="BUY (tiny)",   location=location.belowbar, color=buyColor,  style=shape.triangleup,   size=size.tiny)
plotshape(buySignal and isSmall,  title="BUY (small)",  location=location.belowbar, color=buyColor,  style=shape.triangleup,   size=size.small)
plotshape(buySignal and isNormal, title="BUY (normal)", location=location.belowbar, color=buyColor,  style=shape.triangleup,   size=size.normal)
plotshape(buySignal and isLarge,  title="BUY (large)",  location=location.belowbar, color=buyColor,  style=shape.triangleup,   size=size.large)
plotshape(buySignal and isHuge,   title="BUY (huge)",   location=location.belowbar, color=buyColor,  style=shape.triangleup,   size=size.huge)
plotshape(sellSignal and isTiny,   title="SELL (tiny)",   location=location.abovebar, color=sellColor, style=shape.triangledown, size=size.tiny)
plotshape(sellSignal and isSmall,  title="SELL (small)",  location=location.abovebar, color=sellColor, style=shape.triangledown, size=size.small)
plotshape(sellSignal and isNormal, title="SELL (normal)", location=location.abovebar, color=sellColor, style=shape.triangledown, size=size.normal)
plotshape(sellSignal and isLarge,  title="SELL (large)",  location=location.abovebar, color=sellColor, style=shape.triangledown, size=size.large)
plotshape(sellSignal and isHuge,   title="SELL (huge)",   location=location.abovebar, color=sellColor, style=shape.triangledown, size=size.huge)

if showSetupLbl and buySignal
    label.new(bar_index, low, buyLabel, yloc=yloc.belowbar,
         color=color.new(buyColor, 80), textcolor=buyColor,
         style=label.style_label_up, size=size.tiny)
if showSetupLbl and sellSignal
    label.new(bar_index, high, sellLabel, yloc=yloc.abovebar,
         color=color.new(sellColor, 80), textcolor=sellColor,
         style=label.style_label_down, size=size.tiny)

// ── Alerts so the operator can hook TradingView pop-ups / webhooks ─────────
alertcondition(buySignal,  title="TraderEdge Camarilla BUY",  message="BUY {{ticker}} @ {{close}}")
alertcondition(sellSignal, title="TraderEdge Camarilla SELL", message="SELL {{ticker}} @ {{close}}")
